{
  "name": "observatory-studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "sanity build",
    "check": "tsc --noEmit",
    "dev": "sanity dev --no-auto-updates --port 3333",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "typegen": "sanity schema extract --enforce-required-fields --force && sanity typegen generate"
  },
  "dependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/vision": "^6.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.21.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@sanity/client": "^8.11.0",
    "@types/node": "^22.13.4",
    "sharp": "^0.35.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
