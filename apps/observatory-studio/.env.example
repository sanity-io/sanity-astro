# Sanity project coordinates (not secret)
SANITY_STUDIO_PROJECT_ID=gvy5piix
SANITY_STUDIO_DATASET=production

# Origin of the website that the Presentation tool previews
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:4325

# Set to true once the content variants beta is enabled for the project.
# Adds the variant picker to Presentation for audience previews.
SANITY_STUDIO_VARIANTS_ENABLED=false

# Robot token with write access to the dataset. Only needed for `pnpm seed`.
SANITY_AUTH_TOKEN=
