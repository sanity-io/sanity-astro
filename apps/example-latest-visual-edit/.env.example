# Set 'true' for SSR server, otherwise SSG
PUBLIC_SANITY_PREVIEW_SSR='true'
# Viewer token from sanity.io/management, if using visual editing
SANITY_API_READ_TOKEN='<insert your (long) token>'
# 'true' turns on visual editing if SSR, otherwise not.
PUBLIC_SANITY_VISUAL_EDITING_ENABLED='true'
# This would alter typing assurance operation
# It's normally unset to use default. See documentation for use cases.
# PUBLIC_SANITY_ASSURE_TYPING_INTERVAL='1200'
