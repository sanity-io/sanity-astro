---
import { VisualEditing } from "@sanity/astro/visual-editing";

// Bounding class page-bounds provided to keep visual editing
// blue-rectangle overlays from running to the edge of pages
// on this simple example. Adjust or replace to suit your own
// app design.

// Enable visual editing overlays when the env variable is set to "true"
const visualEditingEnabled =
  import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === "true";

interface Props {
  title: string | null;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="description" content="Astro description" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
</head>
<body>
<VisualEditing enabled={visualEditingEnabled} />

<!--<NewsBar client:only="react" />-->
<main class="page-bounds">
  <slot />
</main>
</body>
</html>
<style is:global>
  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
    --accent-gradient: linear-gradient(
        45deg,
        rgb(var(--accent)),
        rgb(var(--accent-light)) 30%,
        white 60%
    );
  }
  html {
    font-family: system-ui, sans-serif;
    background-size: 224px;
  }
  body {
    margin: 0;
  }
  .page-bounds {
    max-width: 720px;
    margin-inline: auto;
    padding: 1.5rem;
    box-sizing: border-box;
  }
  .page-bounds img {
    max-width: 100%;
    height: auto;
  }
  .page-bounds pre {
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  code {
    font-family:
        Menlo,
        Monaco,
        Lucida Console,
        Liberation Mono,
        DejaVu Sans Mono,
        Bitstream Vera Sans Mono,
        Courier New,
        monospace;
  }
</style>