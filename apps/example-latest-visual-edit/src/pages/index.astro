---
import { getPosts } from '../utils/sanity'
import Layout from '../layouts/Layout.astro'
// we use stegaClean to avoid items from presenting the
// blue buttons to go to Studio. In this case, the plain links
// that we use for our simple posts menu, but this method
// can be used wherever you don't want blue outlines and
// and Open In Studio buttons showing.
import {stegaClean} from '@sanity/client/stega'

interface PostSlug {
  slug: string;
}

const posts = await getPosts()
---

<Layout title="Example Latest Visual Edit Blog">
  <h1>Example Latest Visual Edit Blog Posts</h1>
  <ul>
    {
      posts.map((post: any) => (
        <li>
          <a href={'/posts/' + post.slug.current} class="post-link">
            {stegaClean(post.title)}
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
