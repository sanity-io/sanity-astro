---
import {getLiveEntry} from 'astro:content'

import Layout from '../../layout.astro'

const id = Astro.params.id

if (!id) {
  Astro.response.status = 404
  throw new Error('Movie ID is required.')
}

const {entry, error} = await getLiveEntry('movies', id)

if (error && error.name !== 'LiveEntryNotFoundError') {
  throw error
}

const movie = entry?.data

if (!movie) {
  Astro.response.status = 404
}
---

<Layout title={movie ? (movie.title ?? 'Untitled') : 'Movie Not Found'}>
  {
    movie ? (
      <>
        <p>
          <a href="/">Back to all movies</a>
        </p>
        <h2>{movie.title}</h2>
        {movie.releaseDate ? (
          <p>Release date: {new Date(movie.releaseDate).toLocaleDateString()}</p>
        ) : null}
        <p>
          Movie ID: <code>{movie._id}</code>
        </p>
      </>
    ) : (
      <>
        <h1>Movie Not Found</h1>
        <p>
          <a href="/">Back to all movies</a>
        </p>
      </>
    )
  }
</Layout>
