---
import {getLiveCollection} from 'astro:content'

import Layout from '../layout.astro'

const {entries, error} = await getLiveCollection('movies')

if (error) {
  throw error
}

const movies = entries ?? []
---

<Layout title="Movies">
  <h1>Movies</h1>
  <ol>
    {
      movies.map(({data: movie}) => (
        <li>
          <a href={`/movies/${encodeURIComponent(movie._id)}`}>{movie.title}</a>
        </li>
      ))
    }
  </ol>
</Layout>
