---
import {isImageWithAsset, SanityImage} from '@sanity/astro/image'

// `node` is the image block from astro-portabletext, or an image field.
const {node, width = 960} = Astro.props
---

{
  isImageWithAsset(node) && (
    <SanityImage
      src={node}
      width={Number(width)}
      alt={node.alt || ''}
      title={node.alt}
      placeholder="blur"
    />
  )
}
