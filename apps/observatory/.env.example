# Sanity project coordinates (not secret)
PUBLIC_SANITY_PROJECT_ID=gvy5piix
PUBLIC_SANITY_DATASET=production

# Absolute URL of the Sanity Studio (Visual Editing overlays link into it)
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Canonical origin of this site (canonical URLs, sitemap, Open Graph). Read
# at build time by `site` in astro.config.ts.
PUBLIC_SITE_URL=http://localhost:4325

# Set to true once the content variants beta is enabled for the project and
# `pnpm seed` has published the audience variants.
PUBLIC_SANITY_VARIANTS_ENABLED=false

# Viewer-role robot token. The dataset is public, so this is only needed for
# draft preview through the studio's Presentation tool.
SANITY_API_READ_TOKEN=

# Shared secret for /api/invalidate-tags. Required for purges: while this is
# empty the endpoint returns 503 and deletes nothing. Set the same value on
# the deployment and send it as `Authorization: Bearer <secret>` from the
# server-side caller that should purge (for example a Sanity Function).
SANITY_INVALIDATE_SECRET=

# Set to true once the sync tag invalidate Function is deployed for this
# dataset (see "Sanity Function" in the README). Live events are then held
# back until the CDN has been purged. Leave false until then: held events are
# only released by the Function.
PUBLIC_SANITY_LIVE_WAIT_FOR_FUNCTION=false

# Only read by `sanity.blueprint.ts` at the repository root when deploying the
# Function: the deployed site's purge endpoint, for example
# https://<domain>/api/invalidate-tags. The Function sends
# SANITY_INVALIDATE_SECRET along with it.
INVALIDATE_URL=
