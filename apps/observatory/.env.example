# Sanity project coordinates (not secret)
PUBLIC_SANITY_PROJECT_ID=gvy5piix
PUBLIC_SANITY_DATASET=production

# Absolute URL of the Sanity Studio (Visual Editing overlays link into it)
PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Canonical origin of this site (canonical URLs, sitemap, Open Graph)
PUBLIC_SITE_URL=http://localhost:4325

# Set to true once the content variants beta is enabled for the project and
# `pnpm seed` has published the audience variants.
PUBLIC_SANITY_VARIANTS_ENABLED=false

# Viewer-role robot token. The dataset is public, so this is only needed for
# draft preview through the studio's Presentation tool.
SANITY_API_READ_TOKEN=
