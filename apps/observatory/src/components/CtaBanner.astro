---
import type {HOME_PAGE_QUERY_RESULT} from '../sanity/sanity.types'

interface Props {
  cta: NonNullable<HOME_PAGE_QUERY_RESULT>['cta']
}

const {cta} = Astro.props
---

<section class="py-[clamp(4rem,10vw,7rem)]">
  <div class="mx-auto max-w-6xl px-[clamp(1.25rem,4vw,2.5rem)]">
    <div
      class="rounded-panel border border-line bg-panel p-[clamp(2.5rem,6vw,4.5rem)] text-center text-panel-ink"
    >
      <h2 class="mx-auto max-w-[26ch] text-[clamp(1.75rem,3.5vw,2.5rem)]">{cta.heading}</h2>
      {cta.body && <p class="mx-auto mt-4 max-w-[46ch] text-ink-muted">{cta.body}</p>}
      <a
        class="mt-8 inline-block rounded-full border border-transparent bg-accent px-6 py-3 font-semibold text-page no-underline transition-colors duration-150 hover:bg-accent-strong"
        href={cta.cta.href}>{cta.cta.label}</a
      >
    </div>
  </div>
</section>
