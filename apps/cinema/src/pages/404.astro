---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Not found" description="This page is not in the programme.">
  <section class="mx-auto max-w-xl py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 font-display text-4xl font-semibold tracking-tight text-ink-50 sm:text-5xl">
      Not in the programme.
    </h1>
    <p class="mt-6 text-lg text-ink-300">
      The reel you asked for is not on the bill. It may have been renamed in the Studio, or the
      site has not been rebuilt since.
    </p>
    <a
      href="/"
      class="mt-10 inline-block rounded-full bg-accent px-6 py-3 font-medium text-ink-950 transition-colors hover:bg-accent-soft"
    >
      Back to the films
    </a>
  </section>
</Layout>
