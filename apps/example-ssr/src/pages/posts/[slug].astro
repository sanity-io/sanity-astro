---
import {sanityClient} from 'sanity:client'
import Layout from '../../layouts/Layout.astro'
import PortableText from '../../components/PortableText.astro'
import SanityImage from '../../components/SanityImage.astro'

const post = await sanityClient.fetch(
  `fn image::asset($asset) = $asset->{url, metadata{lqip}};
  fn image::field($image) = $image{..., "asset": image::asset(asset)};
  fn image::blocks($blocks) = $blocks[]{..., _type == "image" => image::field(@)};
  *[_type == "post" && defined(publishedAt) && slug.current == $slug] | order(publishedAt desc) {
    ...,
    authors[]-> {
      name
    },
    "poster": image::field(poster),
    "blurb": image::blocks(blurb),
    "text": image::blocks(text)
  }[0]`,
  {
    slug: Astro.params.slug,
  },
)

const byline = (post.authors || []).map((a: any) => a.name).join(', ')
---

<Layout title={post.title}>
  <article>
    <h1>{post.title}</h1>
    <p>Written by {byline}</p>
    <SanityImage node={post.poster} width="600" />
    <PortableText value={post.blurb} />
    <PortableText value={post.text} />
  </article>
</Layout>
