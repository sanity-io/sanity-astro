{
  "name": "sanity-astro-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:cinema": "turbo run build --filter=cinema...",
    "build:example": "turbo run build --filter=example...",
    "build:example-latest": "turbo run build --filter=example-latest...",
    "build:example-ssr": "turbo run build --filter=example-ssr...",
    "build:minimal": "turbo run build --filter=minimal...",
    "build:movies": "turbo run build --filter=movies...",
    "build:observatory": "turbo run build --filter=observatory... --filter=observatory-studio...",
    "changeset": "changeset",
    "check": "turbo run check",
    "clean": "turbo run clean && rimraf .turbo && rimraf node_modules",
    "dev": "pnpm --filter @sanity/astro build && turbo run dev",
    "dev:cinema": "pnpm --filter @sanity/astro build && turbo run dev --filter=cinema",
    "dev:example": "pnpm --filter @sanity/astro build && turbo run dev --filter=example",
    "dev:example-latest": "pnpm --filter @sanity/astro build && turbo run dev --filter=example-latest",
    "dev:example-ssr": "pnpm --filter @sanity/astro build && turbo run dev --filter=example-ssr",
    "dev:minimal": "pnpm --filter @sanity/astro build && turbo run dev --filter=minimal",
    "dev:movies": "pnpm --filter @sanity/astro build && turbo run dev --filter=movies",
    "dev:observatory": "turbo run dev --filter=observatory --filter=observatory-studio",
    "format": "oxfmt",
    "lint": "turbo run lint",
    "release": "changeset publish",
    "seed:observatory": "pnpm --filter observatory-studio seed",
    "typegen:observatory": "pnpm --filter observatory-studio typegen && pnpm format"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@sanity/blueprints": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-config-custom": "*",
    "oxfmt": "^0.61.0",
    "rimraf": "^5.0.7",
    "turbo": "^2.10.12"
  },
  "packageManager": "pnpm@12.15.0"
}
