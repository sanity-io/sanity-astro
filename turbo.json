{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "pipeline": {
    "clean": {
      "cache": false
    },
    "build": {
      "env": [
        "PUBLIC_SANITY_PROJECT_ID",
        "PUBLIC_SANITY_DATASET",
        "PUBLIC_SANITY_VISUAL_EDITING_ENABLED",
        "PUBLIC_SANITY_STUDIO_URL",
        "PUBLIC_SANITY_VARIANTS_ENABLED",
        "PUBLIC_SITE_URL",
        "SANITY_API_READ_TOKEN",
        "SANITY_STUDIO_PROJECT_ID",
        "SANITY_STUDIO_DATASET",
        "SANITY_STUDIO_PREVIEW_ORIGIN",
        "SANITY_STUDIO_VARIANTS_ENABLED"
      ],
      "dependsOn": ["^build"],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "build/**",
        "public/**",
        ".vercel/output/**"
      ]
    },
    "lint": {},
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
