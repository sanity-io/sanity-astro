{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": [".ailf/**/*.ts"],
  "exclude": ["node_modules", ".ailf/results", ".ailf/contexts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  }
}
