---
import type {VisualEditingConfig} from './client'
import {resolveRefreshStrategy} from './refresh-strategy'

export interface Props extends VisualEditingConfig {
  enabled?: boolean
}

const {enabled, zIndex, keepStegaOnCopy, experimental_refreshStrategy} = Astro.props
const config: VisualEditingConfig = {zIndex, keepStegaOnCopy, experimental_refreshStrategy}
const resolvedStrategy = resolveRefreshStrategy(experimental_refreshStrategy)
const followUpDelayMs =
  resolvedStrategy.type === 'reload' ? (resolvedStrategy.followUpDelayMs ?? 0) : 0
---

{
  enabled ? (
    <>
      <script
        is:inline
        define:vars={{
          followUpDelayMs,
        }}
      >
        ;(() => {
          if (!followUpDelayMs || followUpDelayMs <= 0) return
          const KEY = '@sanity/astro:follow-up-reload'
          const w = window
          if (w.self === w.top || w.__sanityFollowUpInstalled) return
          w.__sanityFollowUpInstalled = true
          w.__sanityVEConfig = {
            acknowledgeRefresh() {
              w.__sanityPendingFollowUpUrl = null
              if (w.__sanityFallbackTimer) {
                clearTimeout(w.__sanityFallbackTimer)
                w.__sanityFallbackTimer = null
              }
            },
          }
          const reconcile = () => {
            let stored = null
            try {
              stored = sessionStorage.getItem(KEY)
              if (stored !== null) sessionStorage.removeItem(KEY)
            } catch {}
            if (stored === location.href) {
              w.__sanityPendingFollowUpUrl = location.href
              if (!w.__sanityFallbackTimer) {
                w.__sanityFallbackTimer = setTimeout(() => {
                  w.__sanityFallbackTimer = null
                  w.__sanityPendingFollowUpUrl = null
                  location.reload()
                }, followUpDelayMs)
              }
            }
          }
          window.addEventListener('message', (e) => {
            if (
              e.data?.type === 'presentation/snapshot-event' &&
              e.data?.data?.event?.type === 'mutation'
            ) {
              try {
                sessionStorage.setItem(KEY, location.href)
              } catch {}
              if (document.readyState === 'complete' && !w.__sanityFallbackTimer) {
                w.__sanityFallbackTimer = setTimeout(() => {
                  w.__sanityFallbackTimer = null
                  w.__sanityPendingFollowUpUrl = null
                  try {
                    sessionStorage.removeItem(KEY)
                  } catch {}
                  location.reload()
                }, followUpDelayMs)
              }
            }
          })
          if (document.readyState === 'complete') reconcile()
          else window.addEventListener('load', reconcile)
        })()
      </script>
      <sanity-astro-visual-editing hidden data-config={JSON.stringify(config)}
      ></sanity-astro-visual-editing>
    </>
  ) : null
}
<script>
  import {install} from './bootstrap'

  install()
</script>
