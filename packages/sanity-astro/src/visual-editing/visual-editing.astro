---
import {VisualEditingComponent, type VisualEditingOptions} from './visual-editing-component'

export interface Props
  extends Pick<VisualEditingOptions, 'zIndex' | 'keepStegaOnCopy' | 'experimental_refreshStrategy'> {
  enabled?: boolean
}

const {enabled, zIndex, keepStegaOnCopy, experimental_refreshStrategy} = Astro.props
---

{
  enabled ? (
    <VisualEditingComponent
      client:only="react"
      zIndex={zIndex}
      keepStegaOnCopy={keepStegaOnCopy}
      experimental_refreshStrategy={experimental_refreshStrategy}
    />
  ) : null
}
