---
import type {VisualEditingConfig} from './client'

export interface Props extends VisualEditingConfig {
  enabled?: boolean
}

const {enabled, zIndex, keepStegaOnCopy, experimental_refreshStrategy} = Astro.props
const config: VisualEditingConfig = {zIndex, keepStegaOnCopy, experimental_refreshStrategy}
---

{
  enabled ? (
    <sanity-astro-visual-editing hidden data-config={JSON.stringify(config)}></sanity-astro-visual-editing>
  ) : null
}
<script>
  import {install} from './bootstrap'

  install()
</script>
