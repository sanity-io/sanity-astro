---
import {VisualEditingComponent, type VisualEditingOptions} from './visual-editing-component'

export interface Props
  extends Pick<VisualEditingOptions, 'zIndex' | 'keepStegaOnCopy' | 'assureTypingInterval'> {
  enabled?: boolean
}

const {enabled, zIndex, keepStegaOnCopy, assureTypingInterval} = Astro.props
---

{
  enabled ? (
    <VisualEditingComponent
      client:only="react"
      zIndex={zIndex}
      keepStegaOnCopy={keepStegaOnCopy}
      assureTypingInterval={assureTypingInterval}
    />
  ) : null
}
