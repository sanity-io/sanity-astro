---
import {FOLLOW_UP_RELOAD_KEY} from './follow-up-reload'
import {resolveRefreshStrategy} from './refresh-strategy'
import {VisualEditingComponent, type VisualEditingComponentProps} from './visual-editing-component'

export interface Props
  extends Pick<
    VisualEditingComponentProps,
    'zIndex' | 'keepStegaOnCopy' | 'experimental_refreshStrategy'
  > {
  enabled?: boolean
}

const {enabled, zIndex, keepStegaOnCopy, experimental_refreshStrategy} = Astro.props

// Normalize strategy at build/SSR time so the inline script receives a numeric delay.
const resolvedStrategy = resolveRefreshStrategy(experimental_refreshStrategy)
const followUpDelayMs = resolvedStrategy.followUpDelayMs ?? 0
---

{
  enabled ? (
  <>
    <script
        is:inline
        define:vars={{followUpDelayMs, flagKey: FOLLOW_UP_RELOAD_KEY}}
    >
      (function () {
        // Expose synchronous refresh acknowledgement hook and shared timer state on window
        // before deferred React island bundles download and hydrate.
        window.__sanityVEConfig = {
          acknowledgeRefresh: function () {
            try {
              sessionStorage.removeItem(flagKey)
            } catch {}
            if (window.__sanityFallbackTimer) {
              clearTimeout(window.__sanityFallbackTimer)
              window.__sanityFallbackTimer = null
            }
          },
        }

        if (window.self === window.top) return
        if (!followUpDelayMs || followUpDelayMs <= 0) return

        // Mark that the inline observer is active so the React island does not attach duplicate listeners.
        window.__sanityFollowUpInstalled = true

        // 1. OBSERVE: Monitor ONLY actual mutation events ('presentation/snapshot-event').
        // Ignoring 'presentation/preview-snapshots' prevents post-refresh and on-load
        // snapshot dumps from falsely re-arming flagKey after acknowledgeRefresh().
        window.addEventListener('message', function (e) {
          if (
            e.data &&
            e.data.type === 'presentation/snapshot-event' &&
            e.data.data &&
            e.data.data.event &&
            e.data.data.event.type === 'mutation'
          ) {
            try {
              sessionStorage.setItem(flagKey, 'true')
            } catch {}
            // Fallback if the page is already loaded and Comlink drops the accompanying refresh:
            // ensure a fallback reload still fires after followUpDelayMs.
            if (
              document.readyState === 'complete' &&
              !window.__sanityFallbackTimer
            ) {
              window.__sanityFallbackTimer = setTimeout(function () {
                window.__sanityFallbackTimer = null
                try {
                  sessionStorage.removeItem(flagKey)
                } catch {}
                window.location.reload()
              }, followUpDelayMs)
            }
          }
        })

        // 2. RECONCILE: Check for missed updates on page arrival.
        window.addEventListener('load', function () {
          var needsSync = false
          try {
            needsSync = sessionStorage.getItem(flagKey) === 'true'
          } catch {}

          if (needsSync && !window.__sanityFallbackTimer) {
            window.__sanityFallbackTimer = setTimeout(function () {
              window.__sanityFallbackTimer = null
              try {
                sessionStorage.removeItem(flagKey)
              } catch {}
              window.location.reload()
            }, followUpDelayMs)
          }
        })
      })()
    </script>
    <VisualEditingComponent
        client:only="react"
        zIndex={zIndex}
        keepStegaOnCopy={keepStegaOnCopy}
        experimental_refreshStrategy={experimental_refreshStrategy}
    />
  </>
    ) : null
  }