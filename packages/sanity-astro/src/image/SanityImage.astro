---
import {Image, imageConfig} from 'astro:assets'

import {getSanityImageProps} from './image-props.js'
import type {SanityImageProps} from './types.js'

type Props = SanityImageProps

const {src, alt, width, height, projectId, dataset, queryParams, placeholder, blurDataURL, ...rest} =
  Astro.props

// Require an explicit string alt prop (e.g. alt={image.alt ?? ''}) rather than
// silently defaulting to '', both for accessibility and because Visual Editing
// relies on stega-encoded text in the rendered alt attribute to attach overlays.
if (typeof alt !== 'string') {
  throw new TypeError(
    '[@sanity/astro]: `<SanityImage>` requires a string `alt` prop (for example `alt={image.alt ?? ""}`). An explicit `alt` is required for accessibility and carries the stega metadata needed for Visual Editing overlays.',
  )
}

// Astro 5 names the default `experimentalObjectFit` while responsive images are experimental.
const config = imageConfig as {objectFit?: string; experimentalObjectFit?: string}

const image = getSanityImageProps(src, {
  width,
  height,
  projectId,
  dataset,
  queryParams,
  placeholder,
  blurDataURL,
  fit: rest.fit ?? config.objectFit ?? config.experimentalObjectFit,
  position: rest.position,
  style: rest.style,
})
---
<Image {...rest} alt={alt} {...image} />